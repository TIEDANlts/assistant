# 复制为 .env 后填写。.env 永不入库（.gitignore 与 pre-commit 双重拦截）。
# 不要写行内注释；值两边的引号可有可无。

# 数据目录：assistant-data 仓库的本地路径（相对路径以代码仓库根目录为准）
ASSISTANT_DATA_DIR=../assistant-data

# 验证 1：smail（腾讯企业邮）。密码填“客户端专用密码”，不是网页登录密码
SMAIL_ADDRESS=
SMAIL_PASSWORD=
SMAIL_IMAP_HOST=imap.exmail.qq.com
SMAIL_IMAP_PORT=993
SMAIL_SMTP_HOST=smtp.exmail.qq.com
SMAIL_SMTP_PORT=465

# 验证 2–4：ehall
EHALL_BASE_URL=https://ehall.nju.edu.cn/
EHALL_AUTH_HOST=authserver.nju.edu.cn
# 只有服务器上的无头密码登录验证需要；本机请在弹出的浏览器里手动登录，留空即可
EHALL_USERNAME=
EHALL_PASSWORD=

# 验证 5：推送（至少配置两个通道）。webhook 地址本身就是密钥
FEISHU_WEBHOOK=
FEISHU_SECRET=
WECOM_WEBHOOK=
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
BARK_SERVER=https://api.day.app
BARK_KEY=
PUSH_TEST_URL=https://example.com/

# 验证 6：模型。LLM_PROVIDER 取 anthropic 或 openai（任意 OpenAI 兼容接口，配合 LLM_BASE_URL）
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# 每百万 token 单价（任意币种，只用于估算单次费用）
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
